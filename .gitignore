# =============================================================================
# Frontend (Bun / Node / Svelte / Vite)
# =============================================================================

# Dependencies
frontend/node_modules/
frontend/.pnp/
frontend/.pnp.js

# Build output
frontend/dist/
frontend/build/
frontend/.svelte-kit/

# Vite
frontend/.vite/
frontend/vite.config.ts.timestamp-*

# Bun
frontend/bun.lockb
frontend/.bun/

# Environment
frontend/.env
frontend/.env.*
!frontend/.env.example

# Collector deploy: host addressing + secrets stay out of git (.example committed)
infra/.env
infra/inventory.yml
tools/espn/.env
tools/espn/mock.yml

# Cache
frontend/.cache/

# =============================================================================
# Backend (Rust / Cargo)
# =============================================================================

# Build artifacts
backend/target/

# Local config (secrets) - similar to appsettings.local.json in .NET
backend/config/local.toml

# MaxMind GeoIP database (large binary, license-gated download)
backend/*.mmdb

# Cargo.lock is typically committed for binaries, but gitignore if you prefer
# backend/Cargo.lock

# =============================================================================
# Build Output
# =============================================================================

# Pico deployment directory (populated by tools/build.py)
pico/

# ROMFS image + staging (produced by tools/build.py flash --release)
/pico.romfs
/romfs_stage/

# Published device app image for OTA (produced by tools/build.py publish-app)
backend/app_dist/

# Published Rust firmware images (produced by tools/build.py publish-fw). The
# per-channel directories are tracked via .gitkeep so the Dockerfile's COPY
# works on a clean checkout; the artifacts themselves never are — they are a
# megabyte apiece and rebuilt from source.
backend/fw_dist/*/image.bin
backend/fw_dist/*/manifest.json
# The raw image publish-fw extracts from the ELF on its way to fw_dist.
/firmware-rs/fw.bin

# ESPN sample store + generated schemas/specs (tools/espn)
/data/

# =============================================================================
# Firmware (MicroPython / Python)
# =============================================================================

# Downloaded dependencies (populated by build.py)
firmware/lib/

# Built/compressed frontend (populated by build.py)
firmware/www/

# Built frontend bundle (produced by tools/build.py from frontend/build/)
/firmware/src/index.html.gz

# Layout modules (generated by tools/compile_layout.py from firmware/assets/layout/)
/firmware/src/scoreboard/layout/

# Font modules (generated by tools/compile_fonts.py from firmware/assets/fonts/).
# __init__.py is hand-written (FontWriter, rgb565, align constants) and stays tracked.
/firmware/src/scoreboard/fonts/*.py
!/firmware/src/scoreboard/fonts/__init__.py

# MicroPython type stubs (copied from Hub75 driver project)
firmware/typings/

# Desktop preview pipeline output + logo cache (tools/preview)
tools/preview/out/
tools/preview/cache/

target/

# MicroPico extension files
firmware/.micropico/

firmware/src/config.json

# Bench credentials for the Rust firmware. build.rs reads this into env vars so
# a probe-flashed image can join a real network before device config storage
# exists (task #12 replaces it). Real SSIDs and passwords live here and must
# never be committed — dev.example.toml is the tracked template.
firmware-rs/app/dev.toml

# Python bytecode
firmware/**/*.pyc
firmware/**/__pycache__/
firmware/**/*.pyo
firmware/**/*.pyd

# Distribution / packaging
firmware/dist/
firmware/build/
firmware/*.egg-info/

# Virtual environments
firmware/.venv/
firmware/venv/
firmware/ENV/

